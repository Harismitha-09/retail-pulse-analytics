    {
      "cell_type": "code",
      "source": [
        "# Count distinct invoices for each customer\n",
        "customer_orders = (\n",
        "    df_clean.dropna(subset=[\"CustomerID\"])\n",
        "    .groupby(\"CustomerID\")[\"InvoiceNo\"]\n",
        "    .nunique()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "# Display the top 10 customers\n",
        "top_10_frequent_customers = customer_orders.head(10)\n",
        "\n",
        "print(top_10_frequent_customers)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "BbRR8Y-wb6_n",

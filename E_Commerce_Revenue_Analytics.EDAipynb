      "source": [
        "product_summary = (\n",
        "    df_clean.dropna(subset=[\"Description\"])\n",
        "    .groupby(\"Description\")\n",
        "    .agg(\n",
        "        TotalRevenue=(\"Revenue\", \"sum\"),\n",
        "        TotalQuantity=(\"Quantity\", \"sum\"),\n",
        "        InvoiceCount=(\"InvoiceNo\", \"nunique\")\n",
        "    )\n",
        "    .sort_values(\"TotalRevenue\", ascending=False)\n",
        ")\n",
        "\n",
        "print(product_summary.head(10).round(2))"
      ],

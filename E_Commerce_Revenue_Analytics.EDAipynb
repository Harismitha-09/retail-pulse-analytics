    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate revenue for each row\n",
        "df_clean[\"Revenue\"] = (\n",
        "    df_clean[\"Quantity\"] * df_clean[\"UnitPrice\"]\n",
        ")\n",
        "\n",
        "# Calculate total revenue for each month\n",
        "monthly_revenue = (\n",
        "    df_clean.groupby(\"YearMonth\")[\"Revenue\"].sum()\n",
        ")\n",
        "\n",
        "print(monthly_revenue)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9Q-6BuvWaHrR",
        "outputId": "119a6ca8-3fbe-449a-8ef7-0db5de5a7449"

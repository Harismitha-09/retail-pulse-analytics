    },
    {
      "cell_type": "code",
      "source": [
        "# Exclude records without a customer ID for this customer analysis\n",
        "customer_data = df_clean.dropna(subset=[\"CustomerID\"]).copy()\n",
        "\n",
        "# Calculate revenue for each invoice\n",
        "invoice_revenue = (\n",
        "    customer_data.groupby(\"InvoiceNo\")[\"Revenue\"]\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "# Calculate Average Order Value\n",
        "aov = invoice_revenue.mean()\n",
        "\n",
        "print(\"Total invoices:\", invoice_revenue.count())\n",
        "print(\"Average Order Value (£):\", round(aov, 2))"
      ],
      "metadata": {
        "colab": {

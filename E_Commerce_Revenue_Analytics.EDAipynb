    {
      "cell_type": "code",
      "source": [
        "# Keep non-cancellation invoices and positive quantities/prices\n",
        "sales_data = sales_data[\n",
        "    (sales_data[\"Quantity\"] > 0) &\n",
        "    (sales_data[\"UnitPrice\"] > 0)\n",
        "].copy()\n",
        "\n",
        "# Recalculate revenue for the retained rows\n",
        "sales_data[\"Revenue\"] = (\n",
        "    sales_data[\"Quantity\"] * sales_data[\"UnitPrice\"]\n",
        ")\n",
        "\n",
        "print(\"Rows retained:\", len(sales_data))\n",
        "print(\"Total revenue (£):\", round(sales_data[\"Revenue\"].sum(), 2))\n",
        "print(\"Distinct invoices:\", sales_data[\"InvoiceNo\"].nunique())\n",

              "\n",
              "     <input type=\"file\" id=\"files-ff88a481-9f86-47f9-bbe7-dade6c8995e0\" name=\"files[]\" multiple disabled\n",
              "        style=\"border:none\" />\n",
              "     <output id=\"result-ff88a481-9f86-47f9-bbe7-dade6c8995e0\">\n",

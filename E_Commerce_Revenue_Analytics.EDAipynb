            "RABBIT NIGHT LIGHT                      66661.63          30631          1009\n",
            "POSTAGE                                 66230.64           3003          1250\n",
            "PAPER CHAIN KIT 50'S CHRISTMAS          63715.24          18876          1170\n",
            "ASSORTED COLOUR BIRD ORNAMENT           58792.42          36282          1467\n",
            "CHILLI LIGHTS                           53746.66          10225           669\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Keep records with a known customer ID\n",
        "customer_data = df_clean.dropna(subset=[\"CustomerID\"]).copy()\n",
        "\n",
        "# Identify the latest transaction date\n",
        "analysis_date = customer_data[\"InvoiceDate\"].max() + pd.Timedelta(days=1)\n",
        "\n",
        "# Calculate RFM metrics\n",
        "rfm = customer_data.groupby(\"CustomerID\").agg(\n",
        "    Recency=(\"InvoiceDate\", lambda x: (analysis_date - x.max()).days),\n",
        "    Frequency=(\"InvoiceNo\", \"nunique\"),\n",
        "    Monetary=(\"Revenue\", \"sum\")\n",
        ")\n",
        "\n",
        "print(rfm.head(10))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TB8EPSL1cqkj",
        "outputId": "7443cd9d-aefe-494a-e788-01172064e023"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "            Recency  Frequency  Monetary\n",
            "CustomerID                              \n",
            "12346.0         326          2      0.00\n",
            "12347.0           2          7   4310.00\n",
            "12348.0          75          4   1797.24\n",
            "12349.0          19          1   1757.55\n",
            "12350.0         310          1    334.40\n",
            "12352.0          36         11   1545.41\n",
            "12353.0         204          1     89.00\n",
            "12354.0         232          1   1079.40\n",
            "12355.0         214          1    459.40\n",
            "12356.0          23          3   2811.43\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Score customers from 1 to 5\n",
        "rfm[\"R_Score\"] = pd.qcut(\n",
        "    rfm[\"Recency\"].rank(method=\"first\"),\n",
        "    5,\n",
        "    labels=[5, 4, 3, 2, 1]\n",
        ").astype(int)\n",
        "\n",
        "rfm[\"F_Score\"] = pd.qcut(\n",
        "    rfm[\"Frequency\"].rank(method=\"first\"),\n",
        "    5,\n",
        "    labels=[1, 2, 3, 4, 5]\n",
        ").astype(int)\n",
        "\n",
        "rfm[\"M_Score\"] = pd.qcut(\n",
        "    rfm[\"Monetary\"].rank(method=\"first\"),\n",
        "    5,\n",
        "    labels=[1, 2, 3, 4, 5]\n",
        ").astype(int)\n",
        "\n",
        "# Combine the three scores\n",
        "rfm[\"RFM_Score\"] = (\n",
        "    rfm[\"R_Score\"].astype(str)\n",
        "    + rfm[\"F_Score\"].astype(str)\n",
        "    + rfm[\"M_Score\"].astype(str)\n",
        ")\n",
        "\n",
        "print(rfm.head(10))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "WowiCPtLcuzy",
        "outputId": "aa8ae120-65b8-4dc7-e011-6529fc9b86e8"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "            Recency  Frequency  Monetary  R_Score  F_Score  M_Score RFM_Score\n",
            "CustomerID                                                                   \n",
            "12346.0         326          2      0.00        1        2        1       121\n",
            "12347.0           2          7   4310.00        5        4        5       545\n",
            "12348.0          75          4   1797.24        2        3        4       234\n",
            "12349.0          19          1   1757.55        4        1        4       414\n",
            "12350.0         310          1    334.40        1        1        2       112\n",
            "12352.0          36         11   1545.41        3        5        4       354\n",
            "12353.0         204          1     89.00        1        1        1       111\n",
            "12354.0         232          1   1079.40        1        1        4       114\n",
            "12355.0         214          1    459.40        1        1        2       112\n",
            "12356.0          23          3   2811.43        4        3        5       435\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def segment_customer(row):\n",
        "    if row[\"R_Score\"] >= 4 and row[\"F_Score\"] >= 4 and row[\"M_Score\"] >= 4:\n",
        "        return \"Best Customers\"\n",
        "\n",
        "    elif row[\"R_Score\"] >= 3 and row[\"F_Score\"] >= 3:\n",
        "        return \"Loyal Customers\"\n",
        "\n",
        "    elif row[\"R_Score\"] >= 4 and row[\"F_Score\"] <= 2:\n",
        "        return \"Recent Customers\"\n",
        "\n",
        "    elif row[\"R_Score\"] <= 2 and row[\"F_Score\"] >= 3:\n",
        "        return \"At-Risk Customers\"\n",
        "\n",
        "    else:\n",
        "        return \"Other Customers\"\n",
        "\n",
        "\n",
        "rfm[\"Segment\"] = rfm.apply(segment_customer, axis=1)\n",
        "\n",
        "print(rfm[[\"Recency\", \"Frequency\", \"Monetary\",\n",
        "           \"RFM_Score\", \"Segment\"]].head(10))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "OU3fSyGQc0h3",
        "outputId": "67850f8b-0b15-40ce-a72e-0b418c31544b"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "            Recency  Frequency  Monetary RFM_Score            Segment\n",
            "CustomerID                                                           \n",
            "12346.0         326          2      0.00       121    Other Customers\n",
            "12347.0           2          7   4310.00       545     Best Customers\n",
            "12348.0          75          4   1797.24       234  At-Risk Customers\n",
            "12349.0          19          1   1757.55       414   Recent Customers\n",
            "12350.0         310          1    334.40       112    Other Customers\n",
            "12352.0          36         11   1545.41       354    Loyal Customers\n",
            "12353.0         204          1     89.00       111    Other Customers\n",
            "12354.0         232          1   1079.40       114    Other Customers\n",
            "12355.0         214          1    459.40       112    Other Customers\n",
            "12356.0          23          3   2811.43       435    Loyal Customers\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "segment_summary = (\n",
        "    rfm[\"Segment\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"Segment\")\n",
        "    .reset_index(name=\"CustomerCount\")\n",
        ")\n",
        "\n",
        "print(segment_summary)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Phr_R-9gc37d",

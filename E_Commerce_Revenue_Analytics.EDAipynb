            "4   Recent Customers            322\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "segment_summary = (\n",
        "    rfm[\"Segment\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"Segment\")\n",
        "    .reset_index(name=\"CustomerCount\")\n",
        ")\n",
        "\n",
        "segment_summary[\"Percentage\"] = (\n",

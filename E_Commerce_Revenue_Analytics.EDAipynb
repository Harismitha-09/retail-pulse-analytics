    {
      "cell_type": "code",
      "source": [
        "# Extract year and month from InvoiceDate\n",
        "df_clean[\"YearMonth\"] = df_clean[\"InvoiceDate\"].dt.to_period(\"M\")\n",
        "\n",
        "# Count transaction records per month\n",
        "monthly_transactions = df_clean[\"YearMonth\"].value_counts().sort_index()\n",
        "\n",
        "print(monthly_transactions)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oVF2gIDZZ6xQ",
        "outputId": "3d40f40c-513b-406b-99f9-d8ee09d20caa"

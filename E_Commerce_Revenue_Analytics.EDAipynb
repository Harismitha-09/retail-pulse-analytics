    {
      "cell_type": "code",
      "source": [
        "Q1 = df_clean[\"Quantity\"].quantile(0.25)\n",
        "Q3 = df_clean[\"Quantity\"].quantile(0.75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower_limit = Q1 - 1.5 * IQR\n",
        "upper_limit = Q3 + 1.5 * IQR\n",
        "\n",
        "print(\"Q1:\", Q1)\n",
        "print(\"Q3:\", Q3)\n",
        "print(\"IQR:\", IQR)\n",
        "print(\"Lower limit:\", lower_limit)\n",
        "print(\"Upper limit:\", upper_limit)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Cvi0YCT3YnWn",
        "outputId": "672db666-5a29-4f3e-801b-37fc70f6e8dd"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Q1: 1.0\n",
            "Q3: 10.0\n",
            "IQR: 9.0\n",
            "Lower limit: -12.5\n",
            "Upper limit: 23.5\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "quantity_outliers = df_clean[\n",
        "    (df_clean[\"Quantity\"] < lower_limit) |\n",
        "    (df_clean[\"Quantity\"] > upper_limit)\n",
        "]\n",
        "\n",
        "print(\"Potential quantity outliers:\", len(quantity_outliers))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rppKqgGVYtTr",
        "outputId": "a63fcaa5-4047-4dfb-e4fd-7ebd9c4f4acf"
      },
      "execution_count": null,

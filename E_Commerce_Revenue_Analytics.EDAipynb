    {
      "cell_type": "code",
      "source": [
        "# Count negative quantities\n",
        "negative_quantity = (df_clean[\"Quantity\"] < 0).sum()\n",
        "\n",
        "# Count non-positive unit prices\n",
        "nonpositive_price = (df_clean[\"UnitPrice\"] <= 0).sum()\n",
        "\n",
        "# Count invoice numbers starting with C\n",
        "cancelled_invoices = (\n",
        "    df_clean[\"InvoiceNo\"].astype(str).str.startswith(\"C\")\n",
        ").sum()\n",
        "\n",
        "print(\"Negative quantity rows:\", negative_quantity)\n",
        "print(\"Non-positive unit price rows:\", nonpositive_price)\n",
        "print(\"Rows with invoice numbers starting with C:\", cancelled_invoices)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TKv3aH-S_B6d",
        "outputId": "3fe30265-3279-4497-c7cb-53b4277b0303"
      },

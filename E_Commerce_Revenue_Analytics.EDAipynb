            "Distinct invoices: 19960\n",
            "Unique customers: 4338\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate sales KPIs\n",
        "total_revenue = sales_data[\"Revenue\"].sum()\n",
        "\n",
        "total_orders = sales_data[\"InvoiceNo\"].nunique()\n",
        "\n",
        "total_customers = sales_data[\"CustomerID\"].nunique()\n",
        "\n",
        "total_products = sales_data[\"StockCode\"].nunique()\n",
        "\n",
        "average_order_value = total_revenue / total_orders\n",
        "\n",
        "# Display the results\n",
        "print(\"Total Revenue (£):\", round(total_revenue, 2))\n",
        "print(\"Total Orders:\", total_orders)\n",
        "print(\"Unique Customers:\", total_customers)\n",
        "print(\"Unique Products:\", total_products)\n",
        "print(\"Average Order Value (£):\", round(average_order_value, 2))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "XjhMstgydl1G",
        "outputId": "e528d255-4c6d-4fa2-c64e-b468868a1620"
      },

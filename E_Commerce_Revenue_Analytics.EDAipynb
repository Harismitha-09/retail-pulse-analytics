            "Total Revenue (£): 10642110.8\n",
            "Total Orders: 19960\n",
            "Unique Customers: 4338\n",
            "Unique Products: 3922\n",
            "Average Order Value (£): 533.17\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Extract the year and month\n",
        "sales_data[\"YearMonth\"] = (\n",
        "    sales_data[\"InvoiceDate\"].dt.to_period(\"M\")\n",
        ")\n",
        "\n",
        "# Summarize monthly performance\n",
        "monthly_summary = (\n",
        "    sales_data.groupby(\"YearMonth\")\n",
        "    .agg(\n",
        "        Revenue=(\"Revenue\", \"sum\"),\n",
        "        Orders=(\"InvoiceNo\", \"nunique\"),\n",
        "        QuantitySold=(\"Quantity\", \"sum\")\n",
        "    )\n",
        ")\n",
        "\n",
        "# Calculate average order value\n",
        "monthly_summary[\"AverageOrderValue\"] = (\n",
        "    monthly_summary[\"Revenue\"] / monthly_summary[\"Orders\"]\n",
        ")\n",
        "\n",
        "print(monthly_summary.round(2))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "SBuYHfz9dq7C",
        "outputId": "a8d026f1-348c-4a2c-c025-6999196490d7"

    {
      "cell_type": "code",
      "source": [
        "df_clean = df.drop_duplicates().copy()\n",
        "\n",
        "print(\"Original dataset shape:\", df.shape)\n",
        "print(\"After removing duplicates:\", df_clean.shape)\n",
        "print(\"Duplicates removed:\", df.shape[0] - df_clean.shape[0])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Gg_gAdyx9qzK",
        "outputId": "2983ee29-6b19-4b54-eeee-33134abdcf4b"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Original dataset shape: (541909, 8)\n",
            "After removing duplicates: (536641, 8)\n",
            "Duplicates removed: 5268\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "df_sales = df_clean[\n",
        "    (~df_clean[\"InvoiceNo\"].astype(str).str.startswith(\"C\")) &\n",
        "    (df_clean[\"Quantity\"] > 0) &\n",
        "    (df_clean[\"UnitPrice\"] > 0)\n",
        "].copy()\n",
        "\n",
        "# Calculate revenue\n",
        "df_sales[\"Revenue\"] = df_sales[\"Quantity\"] * df_sales[\"UnitPrice\"]\n",
        "\n",
        "print(\"Filtered sales dataset shape:\", df_sales.shape)\n",
        "df_sales.head()"
      ],

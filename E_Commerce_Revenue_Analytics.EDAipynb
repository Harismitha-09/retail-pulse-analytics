    {
      "cell_type": "code",
      "source": [
        "# Calculate overall project KPIs\n",
        "total_revenue = df_clean[\"Revenue\"].sum()\n",
        "\n",
        "total_invoices = df_clean[\"InvoiceNo\"].nunique()\n",
        "\n",
        "unique_customers = df_clean[\"CustomerID\"].nunique()\n",
        "\n",
        "total_products = df_clean[\"StockCode\"].nunique()\n",
        "\n",
        "average_order_value = total_revenue / total_invoices\n",
        "\n",
        "print(\"Total Revenue (£):\", round(total_revenue, 2))\n",
        "print(\"Total Invoices:\", total_invoices)\n",
        "print(\"Unique Customers:\", unique_customers)\n",
        "print(\"Unique Products:\", total_products)\n",
        "print(\"Average Order Value (£):\", round(average_order_value, 2))"
      ],

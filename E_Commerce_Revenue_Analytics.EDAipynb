    {
      "cell_type": "code",
      "source": [
        "Q1_price = df_clean[\"UnitPrice\"].quantile(0.25)\n",
        "Q3_price = df_clean[\"UnitPrice\"].quantile(0.75)\n",
        "\n",
        "IQR_price = Q3_price - Q1_price\n",
        "\n",
        "lower_price_limit = Q1_price - 1.5 * IQR_price\n",
        "upper_price_limit = Q3_price + 1.5 * IQR_price\n",
        "\n",
        "print(\"Q1:\", Q1_price)\n",
        "print(\"Q3:\", Q3_price)\n",
        "print(\"IQR:\", IQR_price)\n",
        "print(\"Lower limit:\", lower_price_limit)\n",
        "print(\"Upper limit:\", upper_price_limit)"
      ],

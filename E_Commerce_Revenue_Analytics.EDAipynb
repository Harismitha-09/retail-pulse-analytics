            ],
            "application/javascript": [
              "download(\"download_e90b29b7-1689-4867-9f93-bc841a2223a0\", \"Ecommerce_Sales_Data.csv\", 54537892)"
            ]
          },
          "metadata": {}
        }
      ]
    },

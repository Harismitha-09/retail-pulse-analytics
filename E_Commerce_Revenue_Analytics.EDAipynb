          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Potential quantity outliers: 58501\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "outlier_count = len(quantity_outliers)\n",
        "total_rows = len(df_clean)\n",
        "\n",
        "outlier_percentage = (outlier_count / total_rows) * 100\n",
        "\n",
        "print(\"Total rows:\", total_rows)\n",
        "print(\"Potential outliers:\", outlier_count)\n",
        "print(\"Outlier percentage:\", round(outlier_percentage, 2), \"%\")"
      ],
